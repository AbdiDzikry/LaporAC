<div class="max-w-7xl mx-auto space-y-8 font-sans p-8 pb-20 bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">

    <!-- Header - Enhanced with gradient -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 border-b border-gray-200 pb-6">
        <div>
            <h1 class="text-3xl font-black text-gray-900 tracking-tight bg-gradient-to-r from-blue-600 to-indigo-700 bg-clip-text text-transparent flex items-center gap-3">
                <span class="p-3 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-xl text-white shadow-xl shadow-blue-500/30 transform hover:scale-105 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                </span>
                Executive Dashboard
            </h1>
            <p class="text-gray-600 text-sm mt-2 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-blue-500">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Laporan performa dan monitoring aset real-time.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <button (click)="exportPDF()"
                class="px-4 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-700 text-white text-xs font-bold rounded-xl shadow-md hover:shadow-lg hover:from-blue-700 hover:to-indigo-800 transition-all flex items-center gap-2 transform hover:scale-105">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor"
                    stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Export PDF
            </button>
            <div
                class="px-4 py-2.5 border border-blue-200 rounded-xl bg-gradient-to-r from-blue-50 to-blue-100/50 text-xs text-blue-800 font-bold tracking-wide flex items-center gap-2 shadow-sm">
                <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse shadow-lg shadow-green-500/50"></div>
                Live Data
            </div>
            <div class="text-xs text-gray-500 font-medium text-right px-3 py-2 rounded-xl bg-white border border-gray-200 shadow-sm">
                Last Update<br>
                <span class="text-gray-700 font-bold">{{ currentDate | date:'dd MMM yyyy, HH:mm' }}</span>
            </div>
        </div>
    </div>

    <!-- Date Range Filter - Modernized -->
    <div class="flex flex-wrap items-center gap-3 bg-white p-5 rounded-2xl border border-gray-200 shadow-md">
        <span class="text-xs font-black text-gray-700 uppercase tracking-wider flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-blue-500">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Filter Periode:
        </span>
        <div class="flex gap-2">
            <button
                *ngFor="let p of [{key:'week',label:'Minggu Ini'},{key:'month',label:'Bulan Ini'},{key:'3months',label:'3 Bulan'},{key:'all',label:'Semua'}]"
                (click)="setPreset(p.key)"
                [class]="activePreset === p.key ? 'px-4 py-2 text-xs font-bold rounded-xl bg-gradient-to-r from-blue-600 to-indigo-700 text-white shadow-md' : 'px-4 py-2 text-xs font-medium rounded-xl bg-gray-50 text-gray-600 border border-gray-200 hover:border-blue-300 hover:text-blue-600 transition-all'">
                {{ p.label }}
            </button>
        </div>
        <div class="flex items-center gap-2 ml-auto">
            <input type="date" [(ngModel)]="startDate"
                class="text-sm border-0 ring-1 ring-gray-200 rounded-xl px-4 py-2 focus:ring-2 focus:ring-blue-500 bg-white shadow-sm">
            <span class="text-sm text-gray-400 font-medium">s/d</span>
            <input type="date" [(ngModel)]="endDate"
                class="text-sm border-0 ring-1 ring-gray-200 rounded-xl px-4 py-2 focus:ring-2 focus:ring-blue-500 bg-white shadow-sm">
            <button (click)="applyDateFilter()"
                class="px-4 py-2 text-xs font-bold rounded-xl bg-gradient-to-r from-blue-600 to-indigo-700 text-white hover:from-blue-700 hover:to-indigo-800 transition-all shadow-md hover:shadow-lg transform hover:scale-105">
                Terapkan
            </button>
        </div>
    </div>

    <!-- Loading State -->
    <div *ngIf="loading" class="flex items-center justify-center py-20">
        <div class="text-center">
            <div class="animate-spin rounded-full h-8 w-8 border-2 border-gray-200 border-t-blue-600 mx-auto"></div>
            <p class="mt-4 text-xs text-gray-400 font-medium tracking-wide uppercase">Processing Data...</p>
        </div>
    </div>

    <div *ngIf="!loading" class="space-y-8">

        <!-- KPI Cards - Enhanced with gradients -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

            <!-- Total Assets -->
            <div
                class="group relative p-6 rounded-2xl bg-gradient-to-br from-white to-gray-50 border border-gray-200 hover:border-blue-400 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative flex justify-between items-start mb-4">
                    <div
                        class="p-3 bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl text-blue-600 group-hover:from-blue-600 group-hover:to-blue-700 group-hover:text-white transition-all duration-300 shadow-sm group-hover:shadow-md group-hover:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
                            stroke-width="2" viewBox="0 0 24 24">
                            <path
                                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                            </path>
                        </svg>
                    </div>
                </div>
                <p class="relative text-3xl font-black text-gray-900 tracking-tight">{{ stats.totalAssets }}</p>
                <p class="relative text-xs font-bold text-gray-500 mt-1 uppercase tracking-wide">Total Aset AC</p>
            </div>

            <!-- Total Tickets -->
            <div
                class="group relative p-6 rounded-2xl bg-gradient-to-br from-white to-gray-50 border border-gray-200 hover:border-purple-400 hover:shadow-xl hover:shadow-purple-500/10 transition-all duration-300 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative flex justify-between items-start mb-4">
                    <div
                        class="p-3 bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl text-purple-600 group-hover:from-purple-600 group-hover:to-purple-700 group-hover:text-white transition-all duration-300 shadow-sm group-hover:shadow-md group-hover:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
                            stroke-width="2" viewBox="0 0 24 24">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                    </div>
                </div>
                <p class="relative text-3xl font-black text-gray-900 tracking-tight">{{ stats.totalTickets }}</p>
                <p class="relative text-xs font-bold text-gray-500 mt-1 uppercase tracking-wide">Total Tiket Laporan</p>
            </div>

            <!-- Open Tickets -->
            <div
                class="group relative p-6 rounded-2xl bg-gradient-to-br from-white to-gray-50 border border-gray-200 hover:border-amber-400 hover:shadow-xl hover:shadow-amber-500/10 transition-all duration-300 overflow-hidden">
                <div class="flex justify-between items-start mb-4">
                    <div
                        class="p-3 bg-gray-50 rounded-lg text-gray-400 group-hover:text-amber-600 group-hover:bg-amber-50 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
                            stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                </div>
                <div class="flex items-baseline gap-2">
                    <p class="text-3xl font-bold text-gray-900 tracking-tight">{{ stats.openTickets }}</p>
                    <span class="text-xs font-medium text-amber-600">Active</span>
                </div>
                <p class="text-xs font-semibold text-gray-400 mt-1 uppercase tracking-wide">Tiket Belum Selesai</p>
            </div>

            <!-- Total Cost -->
            <div
                class="group p-6 rounded-xl border border-gray-200 hover:border-blue-600/30 hover:shadow-lg hover:shadow-blue-50 transition-all duration-300">
                <div class="flex justify-between items-start mb-4">
                    <div
                        class="p-3 bg-gray-50 rounded-lg text-gray-400 group-hover:text-green-600 group-hover:bg-green-50 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
                            stroke-width="2" viewBox="0 0 24 24">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-3xl font-bold text-gray-900 tracking-tight">{{ stats.totalMaintenanceCost |
                    currency:'IDR':'symbol':'1.0-0' }}</p>
                <p class="text-xs font-semibold text-gray-400 mt-1 uppercase tracking-wide">Estimasi Biaya Perbaikan</p>
            </div>

        </div>

        <!-- Secondary Stats Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Avg Resolution Time -->
            <div class="p-5 rounded-xl border border-gray-200 flex items-center gap-4">
                <div class="p-3 bg-purple-50 text-purple-600 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <div>
                    <p class="text-xl font-bold text-gray-900">{{ stats.avgResolutionLabel }}</p>
                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Rata-rata Waktu Resolusi</p>
                </div>
            </div>

            <!-- Resolved Tickets -->
            <div class="p-5 rounded-xl border border-gray-200 flex items-center gap-4">
                <div class="p-3 bg-green-50 text-green-600 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <div>
                    <p class="text-xl font-bold text-gray-900">{{ stats.resolvedTickets }}</p>
                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Tiket Terselesaikan</p>
                </div>
            </div>

            <!-- Maintenance Assets -->
            <div class="p-5 rounded-xl border border-gray-200 flex items-center gap-4">
                <div class="p-3 bg-amber-50 text-amber-600 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">
                        <path
                            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z">
                        </path>
                    </svg>
                </div>
                <div>
                    <p class="text-xl font-bold text-gray-900">{{ stats.maintenanceAssets }}</p>
                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Dalam Perawatan</p>
                </div>
            </div>
        </div>

        <!-- Charts Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- Asset Status -->
            <div class="p-6 rounded-xl border border-gray-200 bg-white">
                <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6 pb-4 border-b border-gray-100">
                    Kondisi Aset</h3>
                <div class="h-64 relative">
                    <canvas baseChart [data]="assetStatusChartData" [options]="assetStatusChartOptions"
                        type="doughnut"></canvas>
                    <!-- Center label for doughnut -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                        <span class="text-3xl font-black text-gray-900">{{ stats.totalAssets }}</span>
                        <span class="text-[10px] uppercase font-bold text-gray-400">Unit</span>
                    </div>
                </div>
            </div>

            <!-- Ticket Status -->
            <div class="p-6 rounded-xl border border-gray-200 bg-white">
                <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6 pb-4 border-b border-gray-100">
                    Distribusi Status Tiket</h3>
                <div class="h-64">
                    <canvas baseChart [data]="ticketStatusChartData" [options]="ticketStatusChartOptions"
                        type="bar"></canvas>
                </div>
            </div>

            <!-- Trend -->
            <div class="p-6 rounded-xl border border-gray-200 bg-white lg:col-span-2">
                <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-100">
                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Trend Laporan (6 Bulan
                        Terakhir)</h3>
                    <!-- <select class="text-xs border-gray-200 rounded-lg text-gray-500 font-medium focus:ring-blue-500">
                        <option>Last 6 Months</option>
                        <option>Last Year</option>
                    </select> -->
                </div>
                <div class="h-72">
                    <canvas baseChart [data]="monthlyTrendChartData" [options]="monthlyTrendChartOptions"
                        type="line"></canvas>
                </div>
            </div>

            <!-- Location -->
            <div class="p-6 rounded-xl border border-gray-200 bg-white lg:col-span-2">
                <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6 pb-4 border-b border-gray-100">
                    Top 10 Lokasi dengan Aset Terbanyak</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                    <div class="h-64">
                        <canvas baseChart [data]="locationChartData" [options]="locationChartOptions"
                            type="pie"></canvas>
                    </div>
                    <!-- Custom Legend/List for Locations could go here if design needed -->
                    <div class="space-y-3">
                        <div class="bg-blue-50 p-4 rounded-lg flex items-start gap-3">
                            <div class="p-2 bg-blue-100 text-blue-600 rounded-md">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                                    stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-gray-900">Insight Lokasi</p>
                                <p class="text-xs text-gray-500 mt-1 leading-relaxed">
                                    Sebagian besar aset terkonsentrasi di area operasional utama. Pastikan jadwal
                                    maintenance di area ini (warna biru tua) diprioritaskan.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer / Operational Summary -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-xl border border-red-100 bg-red-50/30 flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-red-600 uppercase tracking-widest mb-1">Perhatian Diperlukan</p>
                    <p class="text-lg font-bold text-gray-900">{{ stats.brokenAssets }} Unit Rusak</p>
                    <p class="text-xs text-gray-500 mt-1">Memerlukan penggantian sparepart atau perbaikan mayor.</p>
                </div>
                <a routerLink="/admin/assets" [queryParams]="{status: 'broken'}"
                    class="px-4 py-2 bg-white border border-red-200 text-red-600 text-xs font-bold rounded-lg shadow-sm hover:bg-red-50 transition-colors">
                    Lihat Unit
                </a>
            </div>

            <div class="p-6 rounded-xl border border-blue-100 bg-blue-50/30 flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-1">Maintenance Aktif</p>
                    <p class="text-lg font-bold text-gray-900">{{ stats.maintenanceAssets }} Unit dalam Perawatan</p>
                    <p class="text-xs text-gray-500 mt-1">Sedang dikerjakan oleh tim teknisi atau vendor.</p>
                </div>
                <a routerLink="/admin/maintenance"
                    class="px-4 py-2 bg-white border border-blue-200 text-blue-600 text-xs font-bold rounded-lg shadow-sm hover:bg-blue-50 transition-colors">
                    Cek Jadwal
                </a>
            </div>
        </div>
    </div>
</div>