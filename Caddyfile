{
    frankenphp
}

# HTTP Port (Matches docker-compose 811:80)
:80 {
    root * /app/public
    encode zstd br gzip

    # API and Laravel Routes
    handle /api* {
        php_server
    }
    
    handle /sanctum* {
        php_server
    }

    # Serve Angular Frontend (SPA)
    handle {
        # Point to the folder where Angular dist was copied
        root * /app/public/frontend
        try_files {path} /index.html
        file_server
    }
}

# HTTPS Port (Requires SSL certificates in /app/ssl)
